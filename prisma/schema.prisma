// Prisma schema file for AIvalytics LMS
// Configured for Supabase PostgreSQL & Edge runtime compatibility

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  LEARNER
  INSTRUCTOR
  ADMIN
}

enum SessionType {
  RECORDING
  LIVE
}

enum SessionStatus {
  CLOSED
  IN_PROGRESS
  UPCOMING
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  fullName      String
  role          Role            @default(LEARNER)
  avatarUrl     String?
  term          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  enrollments   Enrollment[]
  attendance    AttendanceRecord[]
  certificates  Certificate[]
}

model Course {
  id            String          @id @default(uuid())
  code          String          @unique
  title         String
  description   String
  category      String
  instructorId  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  modules       CourseModule[]
  sessions      Session[]
  enrollments   Enrollment[]
  certificates  Certificate[]
}

model CourseModule {
  id          String        @id @default(uuid())
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  order       Int
  lessons     Lesson[]
}

model Lesson {
  id          String        @id @default(uuid())
  moduleId    String
  module      CourseModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  order       Int
  durationMin Int           @default(30)
  videoUrl    String?
  isCompleted Boolean       @default(false)
}

model Session {
  id              String         @id @default(uuid())
  courseId        String
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  type            SessionType    @default(RECORDING)
  status          SessionStatus  @default(CLOSED)
  scheduledAt     DateTime
  durationMinutes Int            @default(90)
  recordingUrl    String?
  meetingUrl      String?
  createdAt       DateTime       @default(now())

  attendance      AttendanceRecord[]
}

model Enrollment {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime  @default(now())
  progress    Float     @default(0.0)

  @@unique([userId, courseId])
}

model AttendanceRecord {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attendedAt  DateTime  @default(now())
  durationMin Int
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?  // null if global broadcast
  title     String
  message   String
  type      String   // "info" | "warning" | "success" | "alert"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SupportTicket {
  id                  String    @id @default(uuid())
  ticketCode          String    @default("")
  userId              String
  studentName         String    @default("Alex Morgan")
  studentEmail        String    @default("alex.morgan@aivalytics.com")
  subject             String
  description         String
  course              String    @default("Academic Information")
  category            String    @default("Academic")
  priority            String    @default("Medium")
  status              String    @default("Open") // "Open" | "Under Review" | "Completed" | "Rejected"
  adminRemarks        String?
  adminRespondedAt    DateTime?
  adminRespondedBy    String?
  studentFeedback     String?   // "Satisfied" | "Not Satisfied"
  studentFeedbackNote String?
  studentFeedbackAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt @default(now())
}

model ClassSession {
  id        String   @id @default(uuid())
  title     String
  status    String   // "SCHEDULED" | "LIVE" | "ENDED"
  startTime DateTime
  createdAt DateTime @default(now())
}

model Certificate {
  id            String    @id @default(uuid())
  credentialId  String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issueDate     DateTime  @default(now())
  grade         String
}
